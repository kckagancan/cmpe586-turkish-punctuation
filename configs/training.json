    "keep_latest_resumable_checkpoints": 2,
    "keep_best_and_final_model_exports": true,
    "keep_candidate_epoch_exports": true,
    "save_optimizer_scheduler_rng_and_sampler_state": true,
    "archive_sources_configs_and_input_hashes": true,
    "overwrite_existing_runs": false
  }
