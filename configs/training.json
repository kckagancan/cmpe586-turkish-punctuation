  "arms": {
    "clean": {"augmentation": false},
    "augmented": {"augmentation": true}
  },
  "training_ablations": {
    "enabled_by_default": false,
    "minimum_planned_drop_one_family": ["case_loss"],
    "optional_drop_one_family": ["diacritic_loss", "typo_swap"],
    "reuse_initialization_row_views_and_remaining_word_plans": true,
