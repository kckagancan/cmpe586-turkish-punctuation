{
  "version": "training-v1",
  "status": "clean_gpu_calibration_complete_full_training_pending",
  "specified_on": "2026-10-18",
  "protocol": "docs/training-protocol.md",
  "model": {
    "source_config": "configs/tokenizer.json",
    "initialization": "base_model_id_at_base_model_revision",
    "architecture": "BertForTokenClassification",
    "attention_implementation": "eager",
    "tokenizer": "model_id_at_revision_from_source_config",
    "require_base_tokenizer_compatibility": true,
    "classifier_initialization": "fresh_four_class_head_saved_once_per_training_seed",
    "initialization_directory": "artifacts/initializations/training-v1",
    "trainable_parameters": "all",
    "hidden_dropout_prob": 0.1,
    "attention_probs_dropout_prob": 0.1,
    "classifier_dropout": 0.1
  },
  "data": {
    "prepared_directory": "data/processed/clean-v1",
    "train_split": "train",
    "validation_split": "validation",
    "expected_train_records": 116969,
    "expected_train_words": 1463897,
    "expected_validation_records": 14453,
    "records_per_epoch": "each_eligible_training_row_exactly_once",
    "shuffle": "shared_row_permutation_per_training_seed_and_epoch",
    "drop_last": false,
    "padding": "dynamic",
    "pad_to_multiple_of": null,
    "max_input_length": 512,
    "truncation": false,
