    "nonfinite_loss_or_gradients": "stop_and_record_failure",
    "hardware_calibration": "short_fresh_initialization_run_before_full_training",
    "allowed_memory_fallback_batches": [[4, 8], [2, 16]],
    "fallback_rule": "resolve_before_paired_runs_keep_effective_batch_32_and_restart_both"
